# Server
PORT=3400

# Database — local MySQL for now; for a cloud database set DB_HOST/credentials and DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_patients
DB_USER=
DB_PASSWORD=
DB_SSL=false
# DB_SSL_CA=

# Auth — the exact values identity-admin-service signs with. This service only
# verifies tokens; it never signs its own.
ADMIN_JWT_SECRET=
ADMIN_JWT_AUDIENCE=
ADMIN_JWT_ISSUER=
# Only needed if ADMIN_JWT_SECRET is unset (RS256/JWKS verification).
ADMIN_JWKS_URL=

# Shared secret for trusted server-to-server callers (X-Tenant-Uuid header required).
PATIENT_SERVICE_INTERNAL_TOKEN=

# organization-admin-service: the registering facility is verified with the caller's own token.
ORGANIZATION_SERVICE_URL=http://localhost:3100/api/v1/organization-admin
# Internal token that service accepts on /geography/* (server-side only; never in a browser).
ORGANIZATION_SERVICE_INTERNAL_TOKEN=

# A person younger than this needs a guardian who is also a registered patient.
MINOR_AGE_YEARS=18

# CORS — comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:4200
